# Local-only development configuration. Copy to .env and change passwords.
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=copilot_platform
PLATFORM_DB_USER=copilot
PLATFORM_DB_PASSWORD=change-me-platform

BUSINESS_DB_HOST=localhost
BUSINESS_DB_PORT=5433
BUSINESS_DB_NAME=northwind
BUSINESS_DB_USER=northwind_admin
BUSINESS_DB_PASSWORD=change-me-business
BUSINESS_DB_READONLY_USER=northwind_reader
BUSINESS_DB_READONLY_PASSWORD=change-me-business-reader
BUSINESS_DB_ALLOWED_SCHEMA=northwind
BUSINESS_DB_CONNECT_TIMEOUT_SECONDS=3
BUSINESS_DB_STATEMENT_TIMEOUT_MS=2000
BUSINESS_DB_METADATA_CACHE_TTL_SECONDS=300

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s

PLATFORM_API_PORT=8080
PLATFORM_JWT_SECRET=replace-with-at-least-32-random-characters
PLATFORM_JWT_ISSUER=enterprise-data-copilot
PLATFORM_ACCESS_TOKEN_TTL=PT30M
# Local demo only. Disable this and provision identities normally outside development.
PLATFORM_BOOTSTRAP_ENABLED=true
PLATFORM_BOOTSTRAP_TENANT_SLUG=northwind
PLATFORM_BOOTSTRAP_TENANT_NAME=Northwind Demo
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@northwind.local
PLATFORM_BOOTSTRAP_ANALYST_EMAIL=analyst@northwind.local
PLATFORM_BOOTSTRAP_PASSWORD=change-me-demo
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_URL=http://localhost:8000
WEB_PORT=3000
# Server-side Web proxy target. This is never supplied by the browser.
PLATFORM_API_URL=http://localhost:8080

AGENT_SERVICE_NAME=agent-service
AGENT_ENVIRONMENT=development
AGENT_VERSION=0.1.0

# P4 model adapter. Keep real keys only in the ignored .env file or a secret manager.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_STRUCTURED_OUTPUT_MODE=json_schema
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_ATTEMPTS=3
LLM_INVALID_RESPONSE_RETRIES=1
LLM_INITIAL_BACKOFF_SECONDS=0.25
LLM_MAX_BACKOFF_SECONDS=2
LLM_APP_NAME=Enterprise Data Copilot

QUERY_SAFETY_MAX_ROWS=100
QUERY_SAFETY_MAX_COLUMNS=50
QUERY_SAFETY_MAX_RESULT_BYTES=1000000
QUERY_SAFETY_MAX_TOTAL_COST=10000
QUERY_SAFETY_MAX_PLAN_ROWS=100000

NL2SQL_MAX_SELECTED_TABLES=6
NL2SQL_MAX_REPAIRS=2

# P6 deterministic embedding baseline and bounded document ingestion.
RAG_EMBEDDING_DIMENSIONS=64
RAG_CHUNK_MAX_CHARACTERS=1200
RAG_CHUNK_OVERLAP_CHARACTERS=120
RAG_RESULT_LIMIT=5
RAG_RRF_K=60
RAG_CACHE_TTL_SECONDS=300
RAG_MIN_LEXICAL_SCORE=0.08
RAG_MIN_VECTOR_SCORE=0.26
RAG_MAX_MARKDOWN_BYTES=2000000
RAG_MAX_PDF_BYTES=10000000
RAG_MAX_PDF_PAGES=100

# P7 service-to-service authentication and durable LangGraph checkpoints.
AGENT_SERVICE_TOKEN=replace-with-a-random-local-token
AGENT_WORKFLOW_SERVICE_TOKEN=replace-with-a-random-local-token
AGENT_WORKFLOW_CHECKPOINT_DSN=postgresql://copilot:change-me-platform@localhost:5432/copilot_platform
AGENT_WORKFLOW_PLATFORM_API_URL=http://localhost:8080
AGENT_WORKFLOW_MAX_REPAIRS=2
AGENT_WORKFLOW_MINIMUM_CONFIDENCE=0.65
LANGGRAPH_STRICT_MSGPACK=true

# P8 bounded background execution, short-lived Redis progress and SSE replay.
ANALYSIS_ASYNC_ENABLED=true
ANALYSIS_ASYNC_CORE_POOL_SIZE=2
ANALYSIS_ASYNC_MAX_POOL_SIZE=4
ANALYSIS_ASYNC_QUEUE_CAPACITY=100
ANALYSIS_ASYNC_MAX_ATTEMPTS=3
ANALYSIS_ASYNC_RETRY_BACKOFF=PT0.2S
ANALYSIS_EVENT_RETENTION=PT1H
ANALYSIS_EVENT_MAX_LENGTH=500
ANALYSIS_SSE_TIMEOUT=PT5M
ANALYSIS_DISPATCH_LEASE=PT5M
