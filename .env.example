# Local-only development configuration. Copy to .env and change passwords.
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=copilot_platform
PLATFORM_DB_USER=copilot
PLATFORM_DB_PASSWORD=change-me-platform

BUSINESS_DB_HOST=localhost
BUSINESS_DB_PORT=5433
BUSINESS_DB_NAME=northwind
BUSINESS_DB_USER=northwind_admin
BUSINESS_DB_PASSWORD=change-me-business
BUSINESS_DB_READONLY_USER=northwind_reader
BUSINESS_DB_READONLY_PASSWORD=change-me-business-reader
BUSINESS_DB_ALLOWED_SCHEMA=northwind
BUSINESS_DB_CONNECT_TIMEOUT_SECONDS=3
BUSINESS_DB_STATEMENT_TIMEOUT_MS=2000
BUSINESS_DB_METADATA_CACHE_TTL_SECONDS=300

REDIS_HOST=localhost
REDIS_PORT=6379

PLATFORM_API_PORT=8080
PLATFORM_JWT_SECRET=replace-with-at-least-32-random-characters
PLATFORM_JWT_ISSUER=enterprise-data-copilot
PLATFORM_ACCESS_TOKEN_TTL=PT30M
AGENT_SERVICE_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8080

AGENT_SERVICE_NAME=agent-service
AGENT_ENVIRONMENT=development
AGENT_VERSION=0.1.0

# P4 model adapter. Keep real keys only in the ignored .env file or a secret manager.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=openai/gpt-4.1-mini
LLM_STRUCTURED_OUTPUT_MODE=json_schema
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_ATTEMPTS=3
LLM_INVALID_RESPONSE_RETRIES=1
LLM_INITIAL_BACKOFF_SECONDS=0.25
LLM_MAX_BACKOFF_SECONDS=2
LLM_APP_NAME=Enterprise Data Copilot

QUERY_SAFETY_MAX_ROWS=100
QUERY_SAFETY_MAX_COLUMNS=50
QUERY_SAFETY_MAX_RESULT_BYTES=1000000
QUERY_SAFETY_MAX_TOTAL_COST=10000
QUERY_SAFETY_MAX_PLAN_ROWS=100000

NL2SQL_MAX_SELECTED_TABLES=6
NL2SQL_MAX_REPAIRS=2

# Added when the internal API is implemented. Never commit the real value.
AGENT_SERVICE_TOKEN=replace-with-a-random-local-token
